{
  "id": "claude_web",
  "name": "Claude Web",
  "version": "1.0.0",
  "description": "OmniRoute-derived Claude Web text chat, strict SSE and explicit recovery history; Chrome TLS with optional on-demand browser fallback.",
  "author": "OmniRoute port (upstream: diegosouzapw)",
  "icon": "MessageSquare",
  "auth_type": "custom_fields",
  "fields": [
    {
      "key": "cookie",
      "label": "Cookie header or sessionKey value",
      "type": "password",
      "required": true,
      "description": "Full claude.ai Cookie header containing sessionKey, or its bare value."
    },
    {
      "key": "orgId",
      "label": "Organization UUID (required for multiple organizations)",
      "type": "password",
      "required": false
    },
    {
      "key": "deviceId",
      "label": "Anthropic device ID",
      "type": "password",
      "required": false
    },
    {
      "key": "locale",
      "label": "Locale (default en-US)",
      "type": "text",
      "required": false
    },
    {
      "key": "timezone",
      "label": "IANA timezone (default UTC)",
      "type": "text",
      "required": false
    },
    {
      "key": "browser_fallback",
      "label": "Allow ephemeral Playwright fallback for recognized 403 challenges",
      "type": "select",
      "required": false,
      "default": "false",
      "options": [
        {
          "label": "Disabled",
          "value": "false"
        },
        {
          "label": "Enabled",
          "value": "true"
        }
      ]
    }
  ],
  "default_models": [
