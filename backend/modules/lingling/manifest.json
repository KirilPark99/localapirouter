{
  "id": "lingling",
  "name": "Lingling · OpenCode over Tor",
  "version": "1.1.0",
  "description": "Real OpenCode through Lingling rotating Tor lanes. Isolated profiles, chat/SSE/reasoning, inline images and client-side agent tool calls. No API key required. No direct fallback or backend tool execution.",
  "icon": "Network",
  "auth_type": "custom_fields",
  "fields": [
    {
      "key": "project_path",
      "label": "Lingling source directory",
      "type": "text",
      "required": true,
      "default": "/home/kiril/PythonProjects/lingling",
      "description": "Uses the existing, unmodified local Lingling project."
    },
    {
      "key": "lanes",
      "label": "Tor lanes",
      "type": "number",
      "required": true,
      "default": 5,
      "description": "1–16 independent Tor lanes. No direct fallback."
    },
    {
      "key": "countries",
      "label": "Primary exit countries",
      "type": "text",
      "required": false,
      "default": "us,de,nl,fr,ro,gb,ca,se,pl,ch",
      "description": "Comma-separated two-letter codes. Ordinary profile proxies are not supported: Lingling owns Tor."
    },
    {
      "key": "fallback_countries",
      "label": "Fallback countries",
      "type": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "preferred_countries",
      "label": "Preferred countries",
      "type": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "startup_timeout",
      "label": "Cold-start timeout (seconds)",
      "type": "number",
      "required": true,
      "default": 600,
      "description": "30–1800 seconds for the first Tor startup; later requests reuse the same kitchen."
    },
    {
      "key": "opencode_path",
      "label": "OpenCode executable (optional)",
      "type": "text",
      "required": false,
      "default": "",
      "placeholder": "Auto-detect opencode on PATH"
    },
    {
      "key": "tor_path",
      "label": "Tor executable (optional)",
      "type": "text",
      "required": false,
      "default": "",
      "placeholder": "Auto-detect tor on PATH"
    }
  ],
  "default_models": [
    {
      "id": "nemotron-3-ultra-free",
      "name": "Nemotron 3 Ultra Free",
      "context_length": 1000000,
      "max_output_tokens": 128000,
