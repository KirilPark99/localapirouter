{
  "id": "lingling",
  "name": "Lingling · OpenCode over Tor / proxies",
  "version": "1.2.0",
  "description": "Real OpenCode through Lingling Tor, ordinary proxy pools or mixed lanes. Isolated profiles, chat/SSE/reasoning, inline images and client-side agent tool calls. No API key required. No direct fallback or backend tool execution.",
  "icon": "Network",
  "auth_type": "custom_fields",
  "fields": [
    {
      "key": "transport_mode",
      "label": "Транспорт",
      "type": "select",
      "required": true,
      "default": "tor",
      "options": [{"label": "Tor", "value": "tor"}, {"label": "Прокси", "value": "proxy"}, {"label": "Tor + прокси", "value": "mixed"}]
    },
    {
      "key": "proxy_policy",
      "label": "Режим пула",
      "type": "select",
      "required": true,
      "default": "balance",
      "options": [{"label": "Балансировка", "value": "balance"}, {"label": "По приоритету", "value": "priority"}]
    },
    {
      "key": "proxy_ids",
      "label": "Ordered proxy pool",
      "type": "textarea",
      "required": false,
      "default": [],
      "description": "Select enabled saved proxies in priority order. Proxy/mixed mode requires a pool or an ordinary profile proxy."
    },
    {
      "key": "project_path",
      "label": "Lingling source directory",
      "type": "text",
      "required": true,
      "default": "/home/kiril/PythonProjects/lingling",
      "description": "Uses the local Lingling checkout with native proxy-pool support."
    },
    {
      "key": "lanes",
      "label": "Tor lanes",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "1–16 independent Tor lanes in Tor/mixed mode; ignored in proxy-only mode. No direct fallback."
    },
    {
      "key": "countries",
      "label": "Primary exit countries",
      "type": "text",
      "required": false,
      "default": "us,de,nl,fr,ro,gb,ca,se,pl,ch",
      "description": "Comma-separated two-letter codes for Tor/mixed mode only."
    },
    {
      "key": "fallback_countries",
      "label": "Fallback countries",
      "type": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "preferred_countries",
      "label": "Preferred countries",
      "type": "text",
      "required": false,
      "default": ""
    },
    {
      "key": "startup_timeout",
      "label": "Cold-start timeout (seconds)",
      "type": "number",
      "required": true,
      "default": 600,
      "description": "30–1800 seconds for transport readiness; later requests reuse the same kitchen."
    },
    {
      "key": "opencode_path",
      "label": "OpenCode executable (optional)",
      "type": "text",
      "required": false,
      "default": "",
      "placeholder": "Auto-detect opencode on PATH"
    },
    {
      "key": "tor_path",
      "label": "Tor executable (optional)",
      "type": "text",
      "required": false,
      "default": "",
      "placeholder": "Auto-detect tor on PATH"
    }
  ],
  "default_models": [
