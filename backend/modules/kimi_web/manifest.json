{
  "id": "kimi_web",
  "name": "Kimi AI Web Chat",
  "version": "1.1.0",
  "description": "Moonshot Kimi Web consumer chat (www.kimi.ai) with Connect-RPC unary envelope framing, reasoning deltas, and multi-turn prompt folding.",
  "author": "Omniroute Port",
  "icon": "MessageSquare",
  "auth_type": "bearer",
  "fields": [
    {
      "key": "access_token",
      "label": "Kimi access_token",
      "type": "password",
      "required": true,
      "placeholder": "access_token from kimi.ai localStorage",
      "description": "DevTools → Application → Local Storage → https://www.kimi.ai → access_token"
    }
  ],
