{
  "id": "agy_cli",
  "name": "Antigravity CLI (agy)",
  "version": "1.0.0",
  "description": "Google Antigravity CLI OAuth integration with auto-discovery from ~/.gemini/antigravity-cli, token auto-refresh, and Cloud Code Assist runtime.",
  "author": "Omniroute Port",
  "icon": "Zap",
  "auth_type": "custom_fields",
  "fields": [
    {
      "key": "auto_detect_local",
      "label": "Auto-detect Local CLI Token",
      "type": "select",
      "required": false,
      "default": "true",
      "options": [
        { "label": "Yes (Read from ~/.gemini/antigravity-cli)", "value": "true" },
        { "label": "No (Use pasted credentials only)", "value": "false" }
      ],
      "description": "Automatically load tokens from local Antigravity CLI installation on this computer"
    },
    {
      "key": "auth_json",
      "label": "Pasted agy Token JSON (Optional)",
      "type": "textarea",
      "required": false,
      "placeholder": "Paste contents of ~/.gemini/antigravity-cli/antigravity-oauth-token...",
      "description": "Raw JSON exported from agy CLI"
    },
    {
      "key": "access_token",
      "label": "Access Token (Optional override)",
      "type": "password",
      "required": false,
      "placeholder": "ya29.a0...",
      "description": "Direct Google OAuth access token"
    },
    {
      "key": "refresh_token",
      "label": "Refresh Token (Optional override)",
      "type": "password",
      "required": false,
      "placeholder": "1//0...",
      "description": "OAuth refresh token for automatic token renewals"
    },
    {
      "key": "project_id",
      "label": "GCP Project ID (Optional)",
      "type": "text",
      "required": false,
      "placeholder": "e.g. my-project-12345",
      "description": "Google Cloud Project ID for Code Assist routing"
    }
  ],
  "default_models": [
