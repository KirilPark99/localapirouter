{
  "id": "notion_web",
  "name": "Notion AI Web",
  "version": "1.2.0",
  "description": "Notion AI internal web inference integration with token_v2 cookie auth, multi-turn thread continuity, transcript builder, and live workspace model roster from getAvailableModels.",
  "author": "Omniroute Port",
  "icon": "Bot",
  "auth_type": "custom_fields",
  "fields": [
    {
      "key": "token_v2",
      "label": "Notion token_v2 Cookie",
      "type": "password",
      "required": true,
      "placeholder": "token_v2 cookie value from app.notion.com",
      "description": "DevTools → Application → Cookies → https://www.notion.so or app.notion.com → token_v2"
    },
    {
      "key": "space_id",
      "label": "Workspace Space ID (Optional)",
      "type": "text",
      "required": false,
      "placeholder": "UUID of your Notion workspace (auto-discovered if empty)",
      "description": "Workspace ID. If omitted, will be auto-resolved from /api/v3/getSpaces"
    }
  ],
  "default_models": [
