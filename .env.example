# ==============================================================================
# MyAIrouter Environment Configuration Example
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database Connection (SQLite default, or PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/myairouter)
DATABASE_URL=sqlite+aiosqlite:///./myairouter.db

# Master Symmetric Encryption Key (generated Fernet key; keep it private)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ROUTER_MASTER_KEY=

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT Session Secret (Random url-safe 32-byte string)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Privacy & Logging Settings
LOG_REQUEST_CONTENT=false
DEFAULT_TIMEOUT_SECONDS=60.0
FUSION_TIMEOUT_SECONDS=120.0
MAX_FALLBACK_ATTEMPTS=5

# Key Fingerprint Salt for duplicate upstream secret detection
# Generate a unique value with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FINGERPRINT_SALT=

# Comma-separated browser origins allowed to use the admin API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep true in HTTPS deployments; set false only for local HTTP development.
COOKIE_SECURE=true

# Antigravity native OAuth application credentials (local only; never commit values)
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
